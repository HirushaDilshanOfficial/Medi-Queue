# Server Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=development
# Optional browser-reachable backend URL used in queue QR codes. For a phone
# on the same Wi-Fi, use the computer's LAN address and port 5001.
# PUBLIC_API_URL=http://<YOUR_LOCAL_IP>:5001

# Database Configuration (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here
